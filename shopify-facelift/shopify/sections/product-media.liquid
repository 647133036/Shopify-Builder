{%- comment -%} sections/product-media.liquid — sticky gallery with thumbnails. Place in a two-column layout beside sections/product-info.liquid. {%- endcomment -%}

<div class="pdp__media">
  <div class="gallery" data-media-container>
    {% if product.featured_media %}
      {% case product.featured_media.media_type %}
        {% when 'image' %}
          {{ product.featured_media | image_url: width: 1600 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '533, 768, 1024, 1280, 1600',
              sizes: '(min-width: 861px) 48vw, 100vw',
              alt: product.featured_media.alt | escape }}
        {% when 'video' %}
          <div class="gallery__video" data-video-id="{{ product.featured_media.id }}">
            <video controls muted playsinline preload="none" style="width:100%;height:100%;object-fit:cover">
              {% if product.featured_media.sources.size > 0 %}
                <source src="{{ product.featured_media.sources[0].url }}" type="video/mp4">
              {% endif %}
            </video>
          </div>
        {% else %}
          {{ product.featured_media.preview_image | image_url: width: 1600 | image_tag:
              loading: 'eager',
              widths: '533, 768, 1024, 1280, 1600',
              sizes: '(min-width: 861px) 48vw, 100vw',
              alt: product.featured_media.alt | escape }}
      {% endcase %}
    {% endif %}
  </div>

  {% if product.media.size > 1 %}
    <div class="thumbs" role="tablist" aria-label="Product media">
      {% for media in product.media %}
        {% if forloop.index > section.settings.thumb_limit %}{% break %}{% endif %}
        <button type="button"
                class="thumb"
                role="tab"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                {% if media.media_type == 'video' %}data-video-src="{{ media.sources[0].url }}"{% endif %}
                data-src="{{ media | image_url: width: 1600 }}"
                data-alt="{{ media.alt | escape }}"
                aria-selected="{{ forloop.first }}"
                aria-label="{{ media.alt | default: 'View media ' | append: forloop.index | escape }}">
          {% case media.media_type %}
            {% when 'video' %}
              <span class="thumb__badge">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </span>
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            {% else %}
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
          {% endcase %}
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product media",
  "class": "product-media",
  "tags": ["product"],
  "settings": [
    {
      "type": "range",
      "id": "thumb_limit",
      "label": "Thumbnail limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
